# Environment configuration for docker-compose.yml
#
#   cp .env.example .env      (run from directory /src, then edit .env for real values)
#
# .env is gitignored, so real values never reach the repository. docker-compose.yml
# falls back to the values below when a variable is unset, which keeps a fresh clone
# and the CI pipeline working without a .env file.
#
# IMPORTANT: credentials are only read the first
# time the volume is created. To change them,
# remove the volume first and let the container initialise again.

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=InventoryDb

# Keycloak admin (the admin console at :8080)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Grafana admin (the dashboards at :3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
